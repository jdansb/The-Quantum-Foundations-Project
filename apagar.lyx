}
\end_layout

\end_inset

 Properties of the inner product
\end_layout

\begin_layout Standard
For vectors 
\begin_inset Formula $\vv$
\end_inset

, 
\begin_inset Formula $\vw$
\end_inset

, 
\begin_inset Formula $\vx$
\end_inset

 (all of the same length) and scalars 
\begin_inset Formula $c$
\end_inset

 the following hold:
\end_layout

\begin_layout Standard
- 
\begin_inset Formula $\vv\cdot(\vw+\vx) = \vv\cdot\vw + \vv\cdot\vx$
\end_inset

 - 
\begin_inset Formula $(\vv+\vw)\cdot\vx = \vv\cdot\vx + \vw\cdot\vx$
\end_inset

 - 
\begin_inset Formula $\vv\cdot(c\vw) = c(\vv\cdot\vw)=(c\vv)\cdot\vw$
\end_inset

 - 
\begin_inset Formula $\vv\cdot\vw = \vw\cdot\vv$
\end_inset

 :::
\end_layout

\begin_layout Standard
## Matrix-vector multiplication
\end_layout

\begin_layout Standard
Matrices can be multiplied by vectors.
\end_layout

